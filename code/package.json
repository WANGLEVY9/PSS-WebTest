{
  "name": "pss-webtest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "campaign:validate": "node experiment/validate-current-campaign.mjs",
    "study:validate": "node analysis/validate-active-study.mjs",
    "study:workflow": "node analysis/study-workflow.mjs",
    "study:runtime": "python3 experiment/runtime_worker.py",
    "sponsor:verify:portable": "node experiment/sponsor-portable-verify.mjs",
    "sponsor:doctor:portable": "node experiment/sponsor-portable-doctor.mjs",
    "sponsor:preflight": "node experiment/sponsor-preflight.mjs --live-environment --write",
    "sponsor:smoke": "node experiment/provider-smoke.mjs",
    "sponsor:console": "node console/server.mjs",
    "test:study-analysis": "node --test tests/experiment/study-analysis.test.mjs tests/experiment/analysis-export.test.mjs tests/experiment/study-pipeline.test.mjs",
    "test:runtime-reliability": "python3 -m unittest discover -s experiment -p 'test_runtime*.py' -v && node --test tests/experiment/reliable-provider.test.mjs tests/experiment/model-routing.test.mjs tests/experiment/provider.test.mjs",
    "test:diagnostic-merge": "node --test tools/merge-wav-qwen-pair.test.mjs",
    "test:experiment": "node --test tests/experiment/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^16.6.1"
  }
}
