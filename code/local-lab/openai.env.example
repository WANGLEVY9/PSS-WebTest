# Copy to code/.env.openai (ignored); chmod 600 code/.env.openai.
# Run with PSS_LOCAL_ENV_FILE=.env.openai from code/. No legacy vendor fallback.
PSS_LOCAL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
# Optional ONLY if supported by the chosen model. Freeze before comparing arms.
# PSS_OPENAI_REASONING_EFFORT=low
PSS_LOCAL_MAX_OUTPUT_TOKENS=1024
PSS_LOCAL_PORT=4173
# Keep disabled until benchmark/reset/evaluator and adapter gates pass.
PSS_LOCAL_ALLOW_DIAGNOSTIC_RUN=0
