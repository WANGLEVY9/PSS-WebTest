# URL of the self-hosted system under test.
SUT_BASE_URL=http://127.0.0.1:3000

# Optional: use an installed Chrome channel when the Playwright Chromium bundle
# is unavailable. Omit this in CI when using `npx playwright install chromium`.
PSS_BROWSER_CHANNEL=chrome

# Configure these only when a CUA adapter is selected; never commit a real key.
# CUA_PROVIDER=
# CUA_MODEL=
# CUA_API_KEY=

# Optional lifecycle overrides. Defaults are pinned in the scripts.
# WEBTESTPILOT_ROOT=../third_party/WebTestPilot
# BOOKSTACK_BASE_URL=http://127.0.0.1:8081
# INDICO_BASE_URL=http://localhost:8080
# JUICE_SHOP_BASE_URL=http://127.0.0.1:3000
# JUICE_SHOP_IMAGE=bkimminich/juice-shop:v20.0.0
