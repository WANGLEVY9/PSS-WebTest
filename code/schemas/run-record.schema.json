{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSS-WebTest immutable run record (v0.1 and v0.2)",
  "type": "object",
  "required": [
    "schema_version", "run_id", "application_id", "application_version",
    "task_id", "condition", "arm", "status", "checkpoint_reached",
    "emitted_verdict", "ground_truth_verdict", "timing", "provenance"
  ],
  "properties": {
    "schema_version": { "enum": ["0.1", "0.2"] },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "application_id": { "type": "string" },
    "application_version": { "type": "string" },
    "task_id": { "type": "string" },
    "condition": { "type": "string" },
    "arm": { "enum": ["visual", "hybrid", "playwright"] },
    "status": {
      "enum": ["completed", "test-failure", "timeout", "model-refusal", "infrastructure-error", "evaluator-error"]
    },
    "checkpoint_reached": { "type": "boolean" },
    "emitted_verdict": { "enum": ["clean", "fault", "unknown", "not-emitted"] },
    "ground_truth_verdict": { "enum": ["clean", "fault", "unknown", "not-scored"] },
    "timing": {
      "type": "object",
      "required": ["wall_time_ms", "actions", "retries"],
      "properties": {
        "wall_time_ms": { "type": "number", "minimum": 0 },
        "actions": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["runner_version", "trace_hash", "observation_contract"],
      "properties": {
        "runner_version": { "type": "string" },
        "trace_hash": { "type": "string" },
        "observation_contract": { "enum": ["screenshot-only", "screenshot-plus-structure", "scripted-locator"] },
        "model_id": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "framework_id": { "type": "string" },
        "framework_version": { "type": "string" },
        "provider_id": { "type": ["string", "null"] },
        "prompt_digest": { "type": ["string", "null"] },
        "action_schema_version": { "type": ["string", "null"] },
        "code_framework": { "type": ["string", "null"] },
        "authoring_source": { "enum": ["human", "llm-generated", "llm-repaired", null] },
        "environment_digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "failure_category": {
      "enum": [
        "perception", "grounding", "planning", "execution", "oracle", "environment", "task-defect",
        "provider", "provider-timeout", "provider-api", "provider-format", "grounding-loop",
        "agent-step-budget", "termination-verdict", "agent-verdict", null
      ]
    },
    "configuration_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "strategy_family": { "enum": ["visual", "hybrid", "scripted"] },
    "protocol_version": { "type": "string", "minLength": 1 },
    "run_manifest_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sut_image_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reset_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "randomization_block": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "0.2" } } },
      "then": {
        "required": ["configuration_id", "strategy_family", "protocol_version", "run_manifest_digest", "sut_image_digest", "reset_digest", "randomization_block"]
      }
    }
  ],
  "additionalProperties": false
}
