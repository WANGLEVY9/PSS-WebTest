# Private shell env, for a browser running on the cloud HOST (not inside Docker).
# Copy to a new private file, chmod 600, set a private reset token before use.
# No model API key belongs in this file. Keep URLs consistent with site base URLs.
DATASET=visualwebarena
CLASSIFIEDS=http://127.0.0.1:9980
CLASSIFIEDS_RESET_TOKEN=
SHOPPING=http://127.0.0.1:7770
REDDIT=http://127.0.0.1:9999
WIKIPEDIA=http://127.0.0.1:8888
HOMEPAGE=http://127.0.0.1:4399
# Optional ONLY when an actual reset endpoint has been implemented and verified:
REDDIT_RESET_URL=
# PSS read-only probes use these names; upstream VWA uses the names above.
PSS_VWA_CLASSIFIEDS_URL=http://127.0.0.1:9980/
PSS_VWA_CLASSIFIEDS_RESET_TOKEN=
PSS_VWA_SHOPPING_URL=http://127.0.0.1:7770/
PSS_VWA_REDDIT_URL=http://127.0.0.1:9999/
PSS_VWA_HOMEPAGE_URL=http://127.0.0.1:4399/
# Fill BOTH token variables with the same private value as the deployed service.
