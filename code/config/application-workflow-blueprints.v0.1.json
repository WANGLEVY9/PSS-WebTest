  "admission_rule": [
    "candidate workflow slots are planning artifacts, not executable observations",
    "each application must have a version-pinned local deployment before a slot becomes runnable",
    "each slot requires a deterministic reset, an independent oracle, and a condition-specific fault/evolution contract",
    "all three arms must run the same intent and persist standardized run records",
    "no candidate workflow contributes to a confirmatory denominator until the application-level matched pilot gate passes"
  ]
