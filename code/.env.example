# URL of the self-hosted system under test.
SUT_BASE_URL=http://127.0.0.1:3000

# Optional: use an installed Chrome channel when the Playwright Chromium bundle
# is unavailable. Omit this in CI when using `npx playwright install chromium`.
PSS_BROWSER_CHANNEL=chrome

# Configure these only when a CUA adapter is selected; never commit a real key.
# CUA_PROVIDER=
# CUA_MODEL=
# CUA_API_KEY=
# CUA_BASE_URL=optional-provider-endpoint
# CUA_COORDINATE_MODE=normalized_1000
# CUA_VISUAL_COORDINATE_MODE=normalized_1000  # or pixels/auto; auto is useful for mixed-model grounding
# DeepSeek V4.1-Flash Vision uses the official API model id
# `deepseek-v4-flash-vision-exp` (the text-only `deepseek-v4-flash` model
# does not accept screenshot inputs).
# Keep the key in a local ignored profile (for example code/.env.deepseek), never commit it.
# CUA_PROVIDER=deepseek
# CUA_MODEL=deepseek-v4-flash-vision-exp
# CUA_BASE_URL=https://api.deepseek.com
# CUA_DEEPSEEK_ACTION_MODE=tool  # or json; both are supported by the API
# CUA_VOLCENGINE_API_MODE=chat  # or responses for Ark Responses API models
# CUA_VOLCENGINE_ACTION_MODE=json  # or tool for Responses function calls

# Optional Volcengine multimodal embedding profile. This is retrieval support,
# not a CUA action-generation model, so do not set CUA_MODEL to this value.
# VOLCENGINE_EMBEDDING_PROVIDER=volcengine
# VOLCENGINE_EMBEDDING_MODEL=doubao-embedding-vision-251215
# VOLCENGINE_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_EMBEDDING_API_KEY=local-only

# Optional isolated external-framework interpreters. These are deliberately
# local paths and are never uploaded. The smoke check only imports packages;
# task-level adapters remain fail-closed until separately conformance-tested.
# PSS_BROWSER_USE_PYTHON=/private/tmp/pss-frameworks/browser-use/bin/python
# PSS_AGENTLAB_PYTHON=/private/tmp/pss-frameworks/agentlab/bin/python

# Optional lifecycle overrides. Defaults are pinned in the scripts.
# WEBTESTPILOT_ROOT=../third_party/WebTestPilot
# BOOKSTACK_BASE_URL=http://127.0.0.1:8081
# PSS_BOOKSTACK_USERNAME=admin@admin.com
# PSS_BOOKSTACK_PASSWORD=replace-in-local-env-only
# INDICO_BASE_URL=http://localhost:8080
# JUICE_SHOP_BASE_URL=http://127.0.0.1:3000
# JUICE_SHOP_IMAGE=bkimminich/juice-shop:v20.0.0
# PSS_INDICO_USERNAME=admin@admin.com
# PSS_INDICO_PASSWORD=replace-in-local-env-only
