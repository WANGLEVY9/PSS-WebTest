  "cross_application_task_families": [
    {
      "id": "issue-to-chat-notification",
      "source_application_types": ["source-hosting", "devops-collaboration"],
      "target_application_types": ["team-chat"],
      "intent": "Create a work item in the source application and verify a corresponding message or notification in the target application.",
      "handoff_contract": ["source-record-id", "target-channel-id", "event-correlation-key", "bounded-eventual-consistency-window"],
      "oracle_layers": ["source-database-or-api", "target-database-or-api", "correlation-log"],
      "conditions": ["clean-stable", "fault-injected", "ui-evolved"],
      "status": "candidate-unverified",
      "admission_requires": ["both-applications-admitted", "shared-reset-coordinator", "independent-cross-app-oracle", "three-arm-matched-pilot"]
    },
    {
      "id": "file-share-to-knowledge-page",
      "source_application_types": ["files-collaboration"],
      "target_application_types": ["knowledge-management", "publishing", "content-management"],
      "intent": "Create or share a file in the source application and add a stable reference to it in the target application.",
      "handoff_contract": ["source-file-id", "share-permission", "target-page-id", "reference-url"],
      "oracle_layers": ["source-file-and-permission-state", "target-page-revision", "reference-integrity"],
      "conditions": ["clean-stable", "fault-injected", "ui-evolved"],
      "status": "candidate-unverified",
      "admission_requires": ["both-applications-admitted", "shared-reset-coordinator", "independent-cross-app-oracle", "three-arm-matched-pilot"]
    },
    {
      "id": "project-work-item-to-release-note",
      "source_application_types": ["project-management", "kanban-project-management"],
      "target_application_types": ["publishing", "content-management", "knowledge-management"],
      "intent": "Complete a project work item and publish a linked release note or knowledge entry in another application.",
      "handoff_contract": ["source-work-item-id", "completion-state", "target-document-id", "backlink"],
      "oracle_layers": ["source-work-item-state", "target-document-revision", "backlink-integrity"],
      "conditions": ["clean-stable", "fault-injected", "ui-evolved"],
      "status": "candidate-unverified",
      "admission_requires": ["both-applications-admitted", "shared-reset-coordinator", "independent-cross-app-oracle", "three-arm-matched-pilot"]
    },
    {
      "id": "business-record-to-approval-chat",
      "source_application_types": ["business-workflow"],
      "target_application_types": ["team-chat", "project-management"],
      "intent": "Create or update a business record and verify an approval request is visible in the target application.",
      "handoff_contract": ["business-record-id", "approval-state", "target-thread-or-work-item-id", "event-correlation-key"],
      "oracle_layers": ["source-relational-state", "target-record-state", "correlation-log"],
      "conditions": ["clean-stable", "fault-injected", "ui-evolved"],
      "status": "candidate-unverified",
      "admission_requires": ["both-applications-admitted", "shared-reset-coordinator", "independent-cross-app-oracle", "three-arm-matched-pilot"]
    }
  ],
  "application_admission_gate": [
    "official source and license evidence recorded",
    "version-pinned self-hosted deployment starts from a clean state",
    "reset-and-ready operation passes three consecutive trials",
    "seed data and test account creation are deterministic",
    "independent oracle checks the intended state without consuming agent-only evidence",
    "clean, fault-injected, and UI-evolved condition contracts are isolated",
    "all three arms complete the same matched pilot workflow",
    "run-record, screenshot digest, action trace, latency, cost, and failure attribution are persisted",
    "only after the above gates pass may the application contribute to confirmatory denominators"
  ],
  "cross_application_admission_gate": [
    "each endpoint application is individually admitted first",
    "reset coordinator restores both applications and the integration channel",
    "handoff identifiers are deterministic and unique per repetition",
    "independent oracle verifies source state, target state, and causal linkage",
    "eventual-consistency bound is declared before collection",
    "fault isolation can identify source failure, target failure, transport failure, and oracle failure",
    "cross-application tasks remain exploratory until a three-arm matched pilot passes"
  ]
}
