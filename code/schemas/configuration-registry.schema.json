{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSS-WebTest configuration registry v0.2",
  "type": "object",
  "required": ["schema_version", "protocol_version", "purpose", "configurations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.2" },
    "protocol_version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/configuration" }
    }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "required": ["configuration_id", "family", "status", "framework", "observation_contract", "runtime", "test_implementation", "admission"],
      "additionalProperties": false,
      "properties": {
        "configuration_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
        "family": { "enum": ["visual", "hybrid", "scripted"] },
        "status": { "enum": ["candidate", "implemented", "legacy-pilot", "admitted", "retired"] },
        "framework": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
        },
        "observation_contract": { "enum": ["screenshot-only", "screenshot-plus-structure", "scripted-locator"] },
        "runtime": {
          "type": "object",
          "required": ["provider_id", "model_id", "action_schema_version", "prompt_digest"],
          "additionalProperties": false,
          "properties": {
            "provider_id": { "type": ["string", "null"] },
            "model_id": { "type": ["string", "null"] },
            "action_schema_version": { "type": ["string", "null"] },
            "prompt_digest": { "type": ["string", "null"] }
          }
        },
        "test_implementation": {
          "type": "object",
          "required": ["code_framework", "authoring_source"],
          "additionalProperties": false,
          "properties": {
            "code_framework": { "type": ["string", "null"] },
            "authoring_source": { "enum": ["human", "llm-generated", "llm-repaired", null] }
          }
        },
        "admission": {
          "type": "object",
          "required": ["status", "evidence"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["not-started", "conformance-passed", "pilot-only", "clean-admitted", "frozen"] },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
